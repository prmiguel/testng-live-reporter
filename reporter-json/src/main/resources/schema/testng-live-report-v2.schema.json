{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/prmiguel/testng-live-reporter/schema/testng-live-report-v2.schema.json",
  "title": "TestNG Live Reporter JSON output (v2)",
  "description": "Either the consolidated report document, or a single NDJSON record. Records are discriminated by their 'type' field. v2 differs from v1 only in the schema version and in that DISCOVERED and IGNORED records are now actually emitted; record shapes are unchanged.",
  "definitions": {
    "testIdentity": {
      "type": "object",
      "required": ["testId", "hash", "className", "methodName", "readableKey", "parameters"],
      "additionalProperties": false,
      "properties": {
        "testId": { "type": "string", "description": "readableKey#hash; stable across runs" },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{16}$", "description": "first 16 hex chars of SHA-256" },
        "className": { "type": "string" },
        "methodName": { "type": "string" },
        "readableKey": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["declaredType", "runtimeType", "value"],
            "additionalProperties": false,
            "properties": {
              "declaredType": { "type": "string" },
              "runtimeType": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "annotations": { "$ref": "#/definitions/testAnnotations" }
      }
    },
    "testAnnotations": {
      "type": "object",
      "description": "The @Test attributes TestNG exposes on ITestNGMethod. Omitted entirely when nothing is set, and never part of the hash: adding these does not change testId.",
      "additionalProperties": false,
      "properties": {
        "groups": { "type": "array", "items": { "type": "string" } },
        "dependsOnGroups": { "type": "array", "items": { "type": "string" } },
        "enabled": { "type": "boolean", "description": "Present only when false; true is the default and omitted" },
        "description": { "type": "string" },
        "priority": { "type": "integer" },
        "timeOut": { "type": "integer", "minimum": 0, "description": "Per-invocation timeout in millis; omitted when 0" },
        "invocationCount": { "type": "integer", "minimum": 0, "description": "Omitted when 1" },
        "retryAnalyzer": { "type": "string", "description": "Fully qualified class name; omitted when none" },
        "dataProvider": { "type": "string" }
      }
    },
    "failure": {
      "type": "object",
      "required": ["type", "message", "stackTrace"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "stackTrace": { "type": "string" },
        "truncated": { "type": "boolean", "description": "True when max-stack-trace-chars cut the trace" }
      }
    },
    "totals": {
      "type": "object",
      "required": ["events", "tests", "passed", "failed", "skipped", "ignored", "timeout",
                   "interrupted", "error", "undetermined", "configurationFailures", "droppedDuplicates",
                   "filtered", "writeErrors"],
      "additionalProperties": false,
      "properties": {
        "events": { "type": "integer", "minimum": 0 },
        "tests": { "type": "integer", "minimum": 0, "description": "Distinct attempts with a terminal status" },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "ignored": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "interrupted": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "undetermined": { "type": "integer", "minimum": 0 },
        "configurationFailures": {
          "type": "integer",
          "minimum": 0,
          "description": "Records with attributes.phase == 'configuration'. Excluded from tests and from the status counters."
        },
        "droppedDuplicates": { "type": "integer", "minimum": 0 },
        "filtered": { "type": "integer", "minimum": 0 },
        "writeErrors": { "type": "integer", "minimum": 0 }
      }
    },
    "runStarted": {
      "type": "object",
      "required": ["type", "schemaVersion", "runId", "startedAt", "reporter"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.started" },
        "schemaVersion": { "const": 2 },
        "runId": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "reporter": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      }
    },
    "testSummary": {
      "type": "object",
      "description": "One entry per attempt: the outcome without the intermediate lifecycle records.",
      "required": ["testId", "readableKey", "className", "methodName", "status", "finishedAt",
                   "suiteName", "testName", "threadName", "invocationIndex", "retryAttempt"],
      "additionalProperties": false,
      "properties": {
        "testId": { "type": "string" },
        "readableKey": { "type": "string" },
        "className": { "type": "string" },
        "methodName": { "type": "string" },
        "parameters": {
          "type": "array",
          "description": "Omitted when the method takes no parameters",
          "items": { "$ref": "#/definitions/testIdentity/properties/parameters/items" }
        },
        "status": {
          "enum": ["PASSED", "FAILED", "SKIPPED", "IGNORED", "TIMEOUT", "INTERRUPTED", "ERROR"]
        },
        "durationMs": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "suiteName": { "type": "string" },
        "testName": { "type": "string" },
        "threadName": { "type": "string" },
        "invocationIndex": { "type": "integer", "minimum": 0 },
        "retryAttempt": { "type": "integer", "minimum": 0 },
        "failure": { "$ref": "#/definitions/failure" }
      }
    },
    "configurationFailureSummary": {
      "type": "object",
      "description": "A @Before*/@After* method that threw. Kept out of tests so totals stay comparable.",
      "required": ["testId", "readableKey", "className", "methodName", "configurationKind",
                   "status", "timestamp", "suiteName", "testName"],
      "additionalProperties": false,
      "properties": {
        "testId": { "type": "string" },
        "readableKey": { "type": "string" },
        "className": { "type": "string" },
        "methodName": { "type": "string" },
        "configurationKind": { "type": "string" },
        "status": { "const": "ERROR" },
        "timestamp": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "suiteName": { "type": "string" },
        "testName": { "type": "string" },
        "failure": { "$ref": "#/definitions/failure" }
      }
    },
    "testEvent": {
      "type": "object",
      "required": ["type", "recordSchemaVersion", "eventSchemaVersion", "sequence", "runId",
                   "executionId", "state", "status", "timestamp", "test", "suiteName", "testName",
                   "threadId", "threadName", "invocationIndex", "retryAttempt"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "test.event" },
        "recordSchemaVersion": { "const": 2 },
        "eventSchemaVersion": { "const": 2, "description": "Core ExecutionEvent.CURRENT_SCHEMA_VERSION" },
        "sequence": { "type": "integer", "minimum": 0 },
        "runId": { "type": "string" },
        "executionId": { "type": "string" },
        "state": {
          "enum": ["DISCOVERED", "QUEUED", "STARTED", "IN_PROGRESS", "FINISHED"],
          "description": "QUEUED is reserved and never emitted: TestNG exposes no callback between discovery and onTestStart."
        },
        "status": {
          "enum": ["UNDETERMINED", "PASSED", "FAILED", "SKIPPED", "IGNORED",
                   "TIMEOUT", "INTERRUPTED", "ERROR"]
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0, "description": "Only present on FINISHED events" },
        "test": { "$ref": "#/definitions/testIdentity" },
        "suiteName": { "type": "string" },
        "testName": { "type": "string" },
        "threadId": { "type": "integer" },
        "threadName": { "type": "string" },
        "invocationIndex": { "type": "integer", "minimum": 0 },
        "retryAttempt": { "type": "integer", "minimum": 0 },
        "failure": { "$ref": "#/definitions/failure" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "phase=configuration marks a configuration-method failure; it is shaped as a test.event so no new record type is needed. Always emitted when phase is present, even with include-attributes=false."
        }
      }
    },
    "runSummary": {
      "type": "object",
      "required": ["type", "schemaVersion", "runId", "startedAt", "finishedAt", "durationMs", "totals"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.summary" },
        "schemaVersion": { "const": 2 },
        "runId": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "totals": { "$ref": "#/definitions/totals" }
      }
    }
  },
  "oneOf": [
    {
      "title": "Consolidated report document",
      "type": "object",
      "required": ["schemaVersion", "run", "tests", "configurationFailures"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 2 },
        "run": { "type": "object" },
        "events": {
          "type": "array",
          "description": "The raw stream, byte-identical to the .ndjson. Omitted when document-events=none.",
          "items": { "$ref": "#/definitions/testEvent" }
        },
        "tests": {
          "type": "array",
          "description": "One entry per attempt that reached a terminal state. Length always equals summary.totals.tests.",
          "items": { "$ref": "#/definitions/testSummary" }
        },
        "configurationFailures": {
          "type": "array",
          "description": "Records with phase=configuration. Length always equals summary.totals.configurationFailures, and they are never part of tests.",
          "items": { "$ref": "#/definitions/configurationFailureSummary" }
        },
        "summary": { "type": "object" }
      }
    },
    {
      "title": "Single NDJSON record",
      "oneOf": [
        { "$ref": "#/definitions/runStarted" },
        { "$ref": "#/definitions/testEvent" },
        { "$ref": "#/definitions/runSummary" }
      ]
    }
  ]
}
